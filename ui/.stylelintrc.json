{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "color-no-hex": [
      true,
      {
        "message": "Hard-coded hex colour. Every colour comes from a token: use var(--…) and see src/styles/tokens.css, which is the only file exempt from this rule."
      }
    ],
    "color-named": [
      "never",
      {
        "message": "Named colour. Every colour comes from a token: use var(--…) and see src/styles/tokens.css, which is the only file exempt from this rule."
      }
    ],
    "function-disallowed-list": [
      ["/^(rgba?|hsla?|hwb|lab|lch|oklab|oklch|color|color-mix|light-dark|drop-shadow)$/i"],
      {
        "message": "Hard-coded colour or shadow function. Both come from tokens: use var(--…) and see src/styles/tokens.css, which is the only file exempt from this rule."
      }
    ],
    "declaration-property-value-allowed-list": [
      {
        "/^(box|text)-shadow$/i": [
          "/^(none|var\\(--(shadow-[a-z0-9-]+|glow)\\)(\\s*,\\s*var\\(--(shadow-[a-z0-9-]+|glow)\\))*)$/i"
        ],
        "/^border(-(top|bottom)-(left|right)|-(start|end)-(start|end))?-radius$/i": [
          "/^(0|var\\(--radius-[a-z0-9-]+\\))(\\s+(0|var\\(--radius-[a-z0-9-]+\\)))*$/i"
        ],
        "/^padding(-(top|right|bottom|left|block|inline)(-(start|end))?)?$/i": [
          "/^(0|var\\(--space-[a-z0-9-]+\\))(\\s+(0|var\\(--space-[a-z0-9-]+\\)))*$/i"
        ],
        "/^margin(-(top|right|bottom|left|block|inline)(-(start|end))?)?$/i": [
          "/^(0|auto|var\\(--space-[a-z0-9-]+\\))(\\s+(0|auto|var\\(--space-[a-z0-9-]+\\)))*$/i"
        ],
        "/^(grid-)?(gap|row-gap|column-gap)$/i": [
          "/^(0|var\\(--space-[a-z0-9-]+\\))(\\s+(0|var\\(--space-[a-z0-9-]+\\)))*$/i"
        ],
        "/^animation-iteration-count$/i": [
          "/^(1|initial|inherit|revert|revert-layer|unset)(\\s*,\\s*(1|initial|inherit|revert|revert-layer|unset))*$/i"
        ],
        "/^(transition|animation)-(duration|delay)$/i": [
          "/^(initial|inherit|revert|revert-layer|unset|(0s|0ms|0|var\\(--motion-[a-z0-9-]+\\))(\\s*,\\s*(0s|0ms|0|var\\(--motion-[a-z0-9-]+\\)))*)$/i"
        ],
        "/^font$/i": [
          "/^(var\\(--type-[a-z0-9-]+\\)|initial|inherit|revert|revert-layer|unset)$/i"
        ],
        "/^font-family$/i": [
          "/^(var\\(--font-[a-z0-9-]+\\)|initial|inherit|revert|revert-layer|unset)$/i"
        ],
        "/^letter-spacing$/i": [
          "/^(0|var\\(--tracking-[a-z0-9-]+\\)|initial|inherit|revert|revert-layer|unset)$/i"
        ],
        "/^(?!font$|font-family$|font-variant-numeric$|letter-spacing$)(font-[a-z-]+|line-height)$/i": [
          "/^(0|initial|inherit|revert|revert-layer|unset)$/i"
        ]
      },
      {
        "message": "Not a design token of the right family. Shadows are var(--shadow-…) or var(--glow); radii are var(--radius-…); spacing is var(--space-…); durations are var(--motion-…); TYPE is a role token — `font: var(--type-…)`, family `var(--font-sans)`, tracking `var(--tracking-…)` — and font-size/font-weight/line-height are carried BY the role, never set beside it. `0` (and `auto` for margin) is always fine. A var() of the WRONG family is invalid CSS that renders as nothing. An animation runs exactly once."
      }
    ],
    "declaration-property-value-disallowed-list": {
      "/^outline$/i": ["/(?:^|\\s)none(?:\\s|$)/i", "/(?:^|\\s)0(?:[a-z%]+)?(?:\\s|$)/i"],
      "/^outline-style$/i": ["/^none$/i"],
      "/^outline-width$/i": ["/^0(?:[a-z%]+)?$/i"],
      "/^outline-color$/i": ["/^transparent$/i"],
      "/^animation$/i": [
        "/(?:^|[\\s,])infinite(?:[\\s,]|$)/i",
        "/(?:^|[\\s,])alternate(?:-reverse)?(?:[\\s,]|$)/i"
      ],
      "/^animation-direction$/i": ["/(?:^|[\\s,])alternate(?:-reverse)?(?:[\\s,]|$)/i"],
      "/^(transition|animation)$/i": [
        "/(?:^|[\\s,(])(?!0(?:m?s)?(?:[\\s,)]|$))\\d*\\.?\\d+(?:e[+-]?\\d+)?m?s(?:[\\s,)]|$)/i",
        "/var\\(\\s*--(?!motion-|ease-)[a-z0-9-]+/i",
        "/(?:^|[\\s,(])(?!var\\(|cubic-bezier\\(|steps\\()[a-z-]+\\(/i"
      ]
    }
  },
  "overrides": [
    {
      "files": ["src/styles/tokens.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null
      }
    },
    {
      "files": ["src/styles/fonts.css"],
      "rules": {
        "declaration-property-value-allowed-list": {
          "/^(box|text)-shadow$/i": [
            "/^(none|var\\(--(shadow-[a-z0-9-]+|glow)\\)(\\s*,\\s*var\\(--(shadow-[a-z0-9-]+|glow)\\))*)$/i"
          ],
          "/^border(-(top|bottom)-(left|right)|-(start|end)-(start|end))?-radius$/i": [
            "/^(0|var\\(--radius-[a-z0-9-]+\\))(\\s+(0|var\\(--radius-[a-z0-9-]+\\)))*$/i"
          ],
          "/^padding(-(top|right|bottom|left|block|inline)(-(start|end))?)?$/i": [
            "/^(0|var\\(--space-[a-z0-9-]+\\))(\\s+(0|var\\(--space-[a-z0-9-]+\\)))*$/i"
          ],
          "/^margin(-(top|right|bottom|left|block|inline)(-(start|end))?)?$/i": [
            "/^(0|auto|var\\(--space-[a-z0-9-]+\\))(\\s+(0|auto|var\\(--space-[a-z0-9-]+\\)))*$/i"
          ],
          "/^(grid-)?(gap|row-gap|column-gap)$/i": [
            "/^(0|var\\(--space-[a-z0-9-]+\\))(\\s+(0|var\\(--space-[a-z0-9-]+\\)))*$/i"
          ],
          "/^animation-iteration-count$/i": [
            "/^(1|initial|inherit|revert|revert-layer|unset)(\\s*,\\s*(1|initial|inherit|revert|revert-layer|unset))*$/i"
          ],
          "/^(transition|animation)-(duration|delay)$/i": [
            "/^(initial|inherit|revert|revert-layer|unset|(0s|0ms|0|var\\(--motion-[a-z0-9-]+\\))(\\s*,\\s*(0s|0ms|0|var\\(--motion-[a-z0-9-]+\\)))*)$/i"
          ]
        }
      }
    }
  ]
}
