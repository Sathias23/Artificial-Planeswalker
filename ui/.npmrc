# `engines.node` in package.json is ADVISORY by default: npm prints a warning and installs
# anyway. That is how `@testing-library/jest-dom@7` (which requires Node >= 22, above this
# project's >=20.19.0 floor) could have been installed cleanly on a developer's Node 24 and
# then failed only on the CI job pinned to node 20 — a class of breakage with no local signal.
#
# engine-strict turns the declared floor into an install-time error, so the floor is enforced
# where it is declared instead of being discovered in CI. Added by story c2-1 (review patch).
engine-strict=true
