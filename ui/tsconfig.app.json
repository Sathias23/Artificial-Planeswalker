{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    /* `DOM.Iterable` is restored deliberately — the create-vite@9 template drops it, and
       without it the first `for...of` over a NodeList, FormData, URLSearchParams or
       Headers downstream fails type-checking with an error that reads like a tsconfig
       mystery rather than a missing lib. Restored by story c2-1 (review patch). */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    /* `strict` is NOT in the create-vite@9 react-ts template — this project adds it.
       NFR-07 asks for a frontend gate equivalent to the Python side's, and the Python
       side is `mypy --strict`; a non-strict tsc is not an equivalent gate. Added by
       story c2-1. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* `tests/fixtures/a11y` is here so the deliberately-inaccessible JSX fixtures belong to
     a tsconfig — ESLint's `projectService` errors on any .tsx outside one, and
     tests/lint-gates.test.ts lints them with ignores disabled. They are valid TSX; only
     the a11y rules object to them. */
  "include": ["src", "tests/fixtures/a11y"]
}
