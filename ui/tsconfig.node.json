{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    /* See the note in tsconfig.app.json — `strict` is added by story c2-1, not the template. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* The node-side half of the project: build config, the shared dev-proxy module it imports,
     and the gate-proving tests (which drive the ESLint/stylelint Node APIs and a real Vite
     server, so they need node types rather than DOM ones). Component tests live in `src`
     and belong to tsconfig.app.json instead. */
  "include": ["vite.config.ts", "config/**/*.ts", "tests/**/*.ts"]
}
