{
  "mcpServers": {
    "artificial-planeswalker": {
      "command": "uv",
      "args": [
        "run",
        "--no-dev",
        "python",
        "-m",
        "src.mcp_server"
      ],
      "cwd": "./server",
      "env": {
        "MCP_TRANSPORT": "stdio"
      }
    },
    "arena-game-state": {
      "command": "uv",
      "args": [
        "run",
        "--no-dev",
        "python",
        "-m",
        "src.arena_server"
      ],
      "cwd": "./server"
    }
  }
}
